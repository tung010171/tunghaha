<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Overlay Intro · Halftone Print</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    height: 100%; overflow: hidden;
    background: #0a0a0a; color: #111;
    font-family: system-ui, -apple-system, sans-serif;
  }

  /* ===== TRANG BÊN DƯỚI ===== */
  .page {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    background: #111;
    color: rgba(255,255,255,.85);
  }
  .page h2 { font-size: clamp(1.8rem, 4vw, 3rem); }

  /* ===== OVERLAY — TỜ GIẤY ===== */
  .overlay {
    position: fixed; inset: 0; z-index: 9999;
    background: #f2ede1;         /* giấy cũ */
    overflow: hidden;
    /* Ẩn: trượt lên + nghiêng nhẹ như giấy bị rút */
    transform: translateY(0) rotate(0deg);
    transform-origin: top center;
    transition: transform 1s cubic-bezier(.77,0,.18,1),
                opacity .9s ease .1s;
    will-change: transform, opacity;
  }
  .overlay.hidden {
    transform: translateY(-105%) rotate(-2deg);
    opacity: 0;
    pointer-events: none;
  }

  /* Hàng kẻ ngang như giấy tập */
  .overlay::before {
    content: "";
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 46px,
      rgba(60,80,120,.10) 46px 47px
    );
    pointer-events: none;
  }
  /* Lỗ đục biên trái/phải */
  .overlay::after {
    content: "";
    position: absolute;
    left: 2.4rem; right: 2.4rem;
    top: 2.4rem; bottom: 2.4rem;
    background-image:
      radial-gradient(circle, rgba(0,0,0,.15) 3px, transparent 3.5px);
    background-size: 100% calc(100% / 3);
    background-repeat: no-repeat;
    background-position: 0 0, 0 50%, 0 100%;
    border: 1px dashed rgba(0,0,0,.12);
    pointer-events: none;
  }

  /* ===== STAGE — NGANG & GIỮA ===== */
  .stage {
    position: absolute; inset: 0; z-index: 10;
    display: flex; align-items: center; justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: 2rem;
    transition: opacity .35s ease;
  }
  .overlay.hidden .stage { opacity: 0; }

  /* ===== CHỮ HALFTONE ===== */
  .greeting {
    display: block;
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1;

    /* Halftone: 2 lớp chấm chồng nhau, chạy ngang */
    background-image:
      radial-gradient(circle, #1a1a1a 1.1px, transparent 1.2px),
      radial-gradient(circle, #1a1a1a 0.9px, transparent 1.0px);
    background-size: 6px 6px, 6px 6px;
    background-position: 0 0, 3px 3px;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 1px rgba(0,0,0,.35);

    animation: halftoneRun 8s linear infinite,
               fadeIn .9s .3s ease both;
    will-change: background-position, opacity;
    white-space: nowrap;
  }
  @keyframes halftoneRun {
    to { background-position: 300% 0, calc(300% + 3px) 3px; }
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ===== NÚT STAMP ===== */
  .start-btn {
    position: relative;
    display: inline-flex; align-items: center; gap: .7rem;
    padding: 1rem 2.4rem;
    font-size: .82rem; font-weight: 700;
    letter-spacing: .32em; text-transform: uppercase;
    color: #111;
    background: transparent;
    border: 2px solid #111;
    border-radius: 6px;
    cursor: pointer;
    transform: translateZ(0);
    transition: transform .35s ease, background .35s ease, color .35s ease;
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
    appearance: none; -webkit-appearance: none;
    outline: none; user-select: none;
    opacity: 0;
    animation: fadeUp .8s .55s ease forwards;
  }
  /* Viền kép kiểu con dấu */
  .start-btn::before {
    content: "";
    position: absolute; inset: 4px;
    border: 1px solid #111;
    border-radius: 3px;
    pointer-events: none;
    transition: inset .35s ease;
  }
  .start-btn:hover {
    background: #111; color: #f2ede1;
    transform: translateZ(0) translateY(-2px);
  }
  .start-btn:hover::before { inset: 5px; border-color: #f2ede1; }
  .start-btn:active { transform: translateZ(0) translateY(0); }
  .start-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(0,0,0,.2);
  }
  .start-btn .arrow {
    display: inline-block;
    transition: transform .35s ease;
    will-change: transform;
  }
  .start-btn:hover .arrow { transform: translateX(5px); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ===== REDUCED MOTION ===== */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
    .greeting, .start-btn { opacity: 1; }
    .overlay.hidden { transform: translateY(-105%); }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 760px) {
    .stage { flex-direction: column; gap: 1.8rem; text-align: center; }
    .greeting { white-space: normal; }
    .start-btn { padding: .85rem 1.9rem; font-size: .72rem; letter-spacing: .22em; }
  }
</style>
</head>
<body>

<div class="page"><h2>Chào mừng bạn</h2></div>

<div class="overlay" id="overlay">
  <div class="stage">
    <h1 class="greeting">Xin chào.</h1>
    <button class="start-btn" id="startBtn">
      Bắt đầu <span class="arrow">→</span>
    </button>
  </div>
</div>

<script>
  const overlay = document.getElementById('overlay');
  const btn     = document.getElementById('startBtn');
  let done = false;

  btn.addEventListener('click', () => {
    if (done) return;
    done = true;
    btn.disabled = true;
    overlay.classList.add('hidden');    // giấy bị rút lên, nghiêng nhẹ
    setTimeout(() => overlay.remove(), 1500);
  });

  btn.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      btn.click();
    }
  });
</script>

</body>
</html>