<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Staggered Scale Blur Reveal</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #05050a;
    font-family: 'Impact', 'Arial Black', sans-serif;
    overflow: hidden;
  }

  .text {
    display: flex;
    gap: 0.03em;
    font-size: clamp(3rem, 15vw, 12rem);
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.02em;
    text-shadow:
      0 0 10px #fff,
      0 0 25px #a855f7,
      0 0 50px #a855f7;
  }

  .text span {
    display: inline-block;
    opacity: 0;
    animation: reveal 0.9s cubic-bezier(0.2, 0.9, 0.3, 1.4) forwards;
  }

  @keyframes reveal {
    0% {
      opacity: 0;
      transform: scale(2) skewX(30deg);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) skewX(0);
      filter: blur(0);
    }
  }

  /* Stagger — mỗi chữ lệch 0.12s */
  .text span:nth-child(1) { animation-delay: 0.1s; }
  .text span:nth-child(2) { animation-delay: 0.22s; }
  .text span:nth-child(3) { animation-delay: 0.34s; }
  .text span:nth-child(4) { animation-delay: 0.46s; }
  .text span:nth-child(5) { animation-delay: 0.58s; }
  .text span:nth-child(6) { animation-delay: 0.7s; }
  .text span:nth-child(7) { animation-delay: 0.82s; }
</style>
</head>
<body>

  <div class="text">
    <span>R</span>
    <span>E</span>
    <span>V</span>
    <span>E</span>
    <span>A</span>
    <span>L</span>
  </div>

</body>
</html>